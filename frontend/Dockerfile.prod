# Build de produccion: compila los assets estaticos y los sirve con nginx.
# A diferencia de frontend/Dockerfile (pensado para desarrollo local con
# "npm run dev" y recarga en caliente), esta imagen es la que se usa para
# despliegues en la nube (ver MANUAL-DESPLIEGUE-NUBE-AWS.md).

FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Vite incrusta las variables VITE_* en el bundle en tiempo de build (no se
# pueden cambiar despues sin volver a construir la imagen).
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
