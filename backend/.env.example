# Entorno local SIN Docker (backend ejecutado directamente con uvicorn).
# Copiar este archivo a "backend/.env" (instalar.bat lo hace automaticamente
# si no existe). La unica diferencia real frente al .env.example de la raiz
# (pensado para docker compose) es que aqui MySQL se conecta por "localhost"
# en vez del nombre de servicio "mysql" de Docker.

APP_NAME="Historia Clinica Psicologica"
ENVIRONMENT=local
DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-in-local
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Debe coincidir con la base de datos y el usuario creados en MySQL siguiendo
# MANUAL-INSTALACION-LOCAL.md.
DATABASE_URL=mysql+pymysql://hist_user:hist_password@localhost:3306/hist_clinica_psic

# Seed inicial (usuario administrador de prueba)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin12345!
SEED_ADMIN_NOMBRE=Administrador Demo
SEED_ADMIN_CEDULA=1000000000
SEED_CONSULTORIO_NIT=900000000-1
SEED_CONSULTORIO_NOMBRE=Consultorio Demo

# Correo local / futuro proveedor SMTP (vacio = no se envian correos reales,
# los envios quedan registrados como exitosos igualmente)
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
